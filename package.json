{
  "name": "rutba-media-fileserver",
  "version": "2.0.0",
  "private": true,
  "description": "Masters-only media origin with on-the-fly resize + LRU cache for images.rutba.pk (Hostinger Node.js hosting)",
  "workspaces": [
    "provider",
    "migrate",
    "test"
  ],
  "main": "server.js",
  "license": "AGPL-3.0-or-later",
  "author": "Ejaz Arain <eharain@yahoo.com> (https://tech-style.co)",
  "homepage": "https://tech-style.co",
  "scripts": {
    "start": "node server.js",
    "pretest": "npm --prefix test install --no-audit --no-fund",
    "test": "node test/test.js",
    "test:videos": "node test/videos.js",
    "pretest:platform": "npm --prefix test install --no-audit --no-fund",
    "test:platform": "node test/platform.js",
    "test:all": "npm test && npm run test:videos && npm run test:platform"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "exif-reader": "^2.0.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "mysql2": "^3.11.0",
    "sharp": "^0.33.5"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.115.0"
  }
}
