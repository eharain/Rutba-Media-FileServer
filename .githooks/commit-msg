#!/bin/sh
# Rejects any commit whose message contains an AI-bot co-authorship or
# generated-by trailer (Claude, Copilot, ChatGPT, OpenAI/GPT, Anthropic).

MSG_FILE="$1"

if grep -qiE '^Co-Authored-By:.*(claude|anthropic|copilot|openai|chatgpt|gpt-[0-9])' "$MSG_FILE" \
  || grep -qiE 'generated with.*(claude|copilot|chatgpt)' "$MSG_FILE" \
  || grep -qE '^🤖' "$MSG_FILE"; then
  echo "" >&2
  echo "commit-msg hook: rejected — commit message contains an AI-bot attribution trailer." >&2
  echo "Remove any 'Co-Authored-By: <AI bot>', '🤖 Generated with ...', or similar line and retry." >&2
  echo "" >&2
  exit 1
fi

exit 0
