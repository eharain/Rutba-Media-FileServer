#!/bin/sh
# Blocks any staged file whose NAME or CONTENT carries an AI-provider
# attribution - Claude, Anthropic, Copilot, ChatGPT, OpenAI/GPT, Cursor,
# Codeium, Tabnine, Windsurf, Kimi, DeepSeek, Gemini, Codex - in any form:
# file names, prose, comments, code, trailers.
#
# Content/file-name counterpart to commit-msg (commit message) and pre-push
# (history). Installed machine-wide via `git config --global core.hooksPath`,
# and versioned in each repo's .githooks/ so the protection travels with a
# clone.
#
# The only files allowed to carry these names are the guardrail files
# themselves, which must name what they block: .githooks/*, AGENTS.md,
# RULES.md (and the .ai-rules.md predecessor). Anything else staged with a
# match is rejected.

PATTERN='claude|anthropic|copilot|chatgpt|openai|gpt-[0-9]|cursor|codeium|tabnine|windsurf|kimi|deepseek|gemini|codex'
HITS=$(mktemp)
trap 'rm -f "$HITS"' EXIT

# NUL-delimited staged paths (added/copied/modified/renamed). tr converts
# NUL to newline so the loop stays in this shell (no subshell state loss).
git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n' | while IFS= read -r path; do
  [ -z "$path" ] && continue

  case "$path" in
    *.githooks/*|AGENTS.md|RULES.md|.ai-rules.md|*/AGENTS.md|*/RULES.md|*/.ai-rules.md)
      continue ;;
  esac

  if printf '%s' "$path" | grep -qiE "$PATTERN"; then
    printf '  NAME: %s\n' "$path" >> "$HITS"
  fi

  blob=$(git ls-files -s -- "$path" | awk '{print $2}')
  [ -z "$blob" ] && continue
  if git cat-file -p "$blob" 2>/dev/null | grep -qiE "$PATTERN"; then
    printf '  CONTENT: %s\n' "$path" >> "$HITS"
  fi
done

if [ -s "$HITS" ]; then
  echo "" >&2
  echo "pre-commit hook: rejected - staged file(s) carry an AI-provider name in the file name or content:" >&2
  cat "$HITS" >&2
  echo "" >&2
  echo "Rename the file / remove the reference. Files that legitimately document this" >&2
  echo "policy belong in AGENTS.md / RULES.md or .githooks/, which are allow-listed." >&2
  echo "" >&2
  exit 1
fi

exit 0