#!/bin/sh
# Second line of defense: scans every commit about to be pushed (not just
# newly-created ones) for an AI-bot attribution trailer, and blocks the push
# if any are found. Catches commits made with `commit --no-verify`, imported
# via cherry-pick/patch/rebase from elsewhere, or already sitting in history.

z40=0000000000000000000000000000000000000000
bad=0
matches=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue   # deleting a ref, nothing to check

  if [ "$remote_sha" = "$z40" ]; then
    range="$local_sha"                    # brand-new ref: check its full history
  else
    range="$remote_sha..$local_sha"
  fi

  for c in $(git rev-list "$range" -- 2>/dev/null); do
    hit=$(git show -s --format="%B" "$c" | grep -iE '^Co-Authored-By:.*(claude|anthropic|copilot|openai|chatgpt|gpt-[0-9]|cursor|codeium|tabnine|windsurf|kimi|deepseek|gemini|codex)|generated with.*(claude|copilot|chatgpt|cursor|codeium|tabnine|windsurf|kimi|deepseek|gemini|codex)|^ðŸ¤–')
    if [ -n "$hit" ]; then
      bad=1
      matches="$matches\n  $c ($remote_ref): $hit"
    fi
  done
done

if [ "$bad" -eq 1 ]; then
  echo "" >&2
  echo "pre-push hook: rejected â€” commit(s) about to be pushed contain an AI-bot attribution trailer:" >&2
  printf "%b\n" "$matches" >&2
  echo "" >&2
  exit 1
fi

exit 0
