# ─────────────────────────────────────────────────────────────────────────────
# Rutba Media File Server — reference environment
#
# Copy to `.env` (or `deploy/.env` for Docker Compose) and uncomment what you need.
#
# EVERY BLOCK BELOW EXCEPT "Core" IS OPTIONAL AND GATED. With none of them set the
# server is the original masters-only image origin: public reads, token-gated
# writes, no database, no console, no jobs, no AI, no WebDAV. Turning a block on
# never changes the behavior of the blocks above it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (the plain origin) ──────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Masters (source of truth). Aliases: MASTER_DIR, MEDIA_DIR. A leading `~` expands.
UPLOAD_DIR=./public
# Generated variants; size-capped, LRU-evicted. Safe to delete at any time.
CACHE_DIR=./.cache
CACHE_MAX_BYTES=1073741824
IMAGE_QUALITY=80
MAX_DIM=4000
# Strapi prefix → width map (JSON). Omit for the built-in breakpoints.
#VARIANTS={"thumbnail":245,"xsmall":64,"small":500,"medium":750,"large":1000,"xlarge":1920}
# Shared secret for provider/migration PUT+DELETE. Empty ⇒ no token writes at all.
UPLOAD_TOKEN=
# Max PUT body in bytes (alias SIZE_LIMIT); 0 disables the cap.
UPLOAD_MAX_BYTES=268435456
CORS_ORIGIN=*

# ── Origin pull-through (optional) ───────────────────────────────────────────
# Missing master ⇒ download from the first base URL that has it, persist, serve.
# Empty ⇒ a missing master is a plain 404.
#ORIGIN_SOURCES=https://bucket.s3.amazonaws.com https://old-strapi.example/uploads
#ORIGIN_TIMEOUT_MS=10000

# ── Clustering (optional) ────────────────────────────────────────────────────
# Replicate masters between nodes and pull on miss, gated by role + visibility.
# Empty CLUSTER_PEERS ⇒ clustering off.
#CLUSTER_ROLE=public                  # public (internet-facing) | private (LAN)
#CLUSTER_PEERS=https://images.example.com|public http://nas.lan:3000|private
#CLUSTER_SECRET=
#CLUSTER_TIMEOUT_MS=10000
# Path prefixes whose masters are private by default (segment-aware).
#PRIVATE_PATHS=private secure/docs

# ── Multi-volume storage (optional) ──────────────────────────────────────────
# MASTER_DIR is always volume `default`. Extra volumes: "id:path" or "id:path|ro".
# Unset ⇒ single-volume, identical to before.
#STORAGE_VOLUMES=disk2:/mnt/disk2 archive:/mnt/archive|ro
#STORAGE_PLACEMENT=free               # free (most free space) | fill | route
#STORAGE_ROUTES=archive/=archive

# ── Media processing (optional, ffmpeg) ──────────────────────────────────────
# Resolution order: these paths → bundled ffmpeg-static/ffprobe-static → PATH.
# No binary anywhere ⇒ posters/transcodes off, videos stream as-is.
#FFMPEG_PATH=/usr/bin/ffmpeg
#FFPROBE_PATH=/usr/bin/ffprobe

# ── Platform layer: database (optional — the master switch) ──────────────────
# Set DB_HOST (or DB_URL) to enable accounts, RBAC, the file index, audit log,
# /_api, /_ui, /_s, trash, shares and the job queue. Unset ⇒ ALL of that is absent.
# MYSQL_* are accepted as aliases for every DB_* below.
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_USER=root
#DB_PASSWORD=
#DB_NAME=media
#DB_POOL=10
#DB_URL=mysql://user:pass@127.0.0.1:3306/media
# Boot-time connect retries (1s apart) before degrading to origin-only. Useful when
# the database container starts alongside the server.
#DB_CONNECT_RETRIES=0

# ── Platform layer: accounts & sessions ──────────────────────────────────────
# Open self-service registration. The FIRST account is always allowed (bootstrap
# admin) regardless; after that this flag decides.
#ALLOW_REGISTRATION=0
#SESSION_TTL_DAYS=30
# Read authorization: public (default, unchanged) | mixed (private files need
# auth) | private (every read needs an authenticated, permitted user).
#READ_AUTH_MODE=public
# `Secure` flag on the session cookie and HTTPS requirement for WebDAV Basic auth:
# auto (secure when the request arrived over TLS) | always | never.
#SECURE_COOKIES=auto
# Failed-login throttling: lock an account/IP after N failures within the window.
#LOGIN_MAX_FAILURES=10
#LOGIN_WINDOW_MINUTES=15
#LOGIN_LOCKOUT_MINUTES=15

# ── Platform layer: trash ────────────────────────────────────────────────────
# Deleted masters move here (outside every served volume) so they can be restored.
# Defaults to a sibling of MASTER_DIR — set it explicitly in containers so it maps
# to a persistent volume rather than the writable layer.
#TRASH_DIR=/data/trash

# ── Platform layer: WebDAV ───────────────────────────────────────────────────
# Mount the whole store as a network drive at /_dav/ (needs the DB layer).
# On by default once the DB layer is up; set to 0 to disable.
#WEBDAV_ENABLED=1

# ── Background jobs (optional, needs the DB layer) ───────────────────────────
# The worker that runs scans, metadata extraction, transcodes, enrichment and
# scrubs. Off ⇒ those features degrade to nothing being processed in background.
#JOBS_ENABLED=1
#JOBS_CONCURRENCY=2
#JOBS_POLL_MS=1000
#JOBS_MAX_ATTEMPTS=5
# Reconcile the filesystem into the index once at boot (also available on demand
# from the console / POST /_api/jobs). Recommended after mounting existing masters.
#SCAN_ON_BOOT=0
#SCAN_RATE_FILES_PER_SEC=200

# ── AI enrichment (optional, needs the DB layer + job queue) ─────────────────
# No key ⇒ every enrichment job type is unregistered and the console tab is absent.
#ANTHROPIC_API_KEY=
#AI_MODEL=claude-opus-5
#AI_MAX_IMAGE_DIM=1568
#AI_MONTHLY_BUDGET_USD=50
#AI_ENABLED=1

# ── Video packaging (optional, needs ffmpeg + the job queue) ─────────────────
# HLS ladder for adaptive streaming, rendered in the background and served at /_v/.
#HLS_ENABLED=0
#HLS_LADDER=360,720,1080
#HLS_SEGMENT_SECONDS=6
# Secret that signs short-lived playback URLs. Empty ⇒ playback URLs are unsigned.
#PLAYBACK_SECRET=
#PLAYBACK_TTL_SECONDS=3600

# ── Docker Compose only (deploy/.env) ────────────────────────────────────────
# Consumed by deploy/docker-compose*.yml, not by the server itself.
#MEDIA_UPLOAD_TOKEN=change-me
#MYSQL_PASSWORD=change-me
